{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://dhara-alert-gis.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://dhara-alert-gis.onrender.com/uploads/:path*" },
    { "source": "/((?!api|uploads).*)", "destination": "/index.html" }
  ]
}
